# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://our_universe:change_me_super_secret_password@db:5432/our_universe

# Database Credentials (used by docker-compose to initialize the DB container)
DB_NAME=our_universe
DB_USER=our_universe
DB_PASSWORD=change_me_super_secret_password

# Authentication Secret (Used for signing sessions - generate a random string)
# You can generate one with `openssl rand -base64 32`
SESSION_SECRET=change_me_to_a_long_random_secret

# Shared Couple Passcode
# You must generate an argon2id hash for the couple's shared passcode.
# Important: Escape ALL `$` symbols with `\$` so Next.js doesn't treat them as variables!
# You can generate a hash using the terminal:
# node -e "require('argon2').hash('your_passcode').then(console.log)"
COUPLE_PASSCODE_HASH='\$argon2id\$v=19\$m=65536,p=4,t=3\$hg677bkYXduxR9yqRb0Uzw\$byqW9EOGtcICaLFUGHZXmWsA8bLQzWkHcVE3cNIIfVk'

# Upload Limits (in Megabytes)
UPLOAD_MAX_IMAGE_MB=20
UPLOAD_MAX_VIDEO_MB=500
